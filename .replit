modules = ["nodejs-24", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
PORTAL_WEBHOOK_URL = "https://portaltreasurekc.org"
PORTAL_WEBHOOK_PATH = "/webhook/llcs"

[nix]
channel = "stable-25_05"
